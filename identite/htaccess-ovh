# Réglages du serveur Apache de l'hébergement OVHcloud (MEMO_atlas_apropos.md §64).
# Déposé sous le nom .htaccess à la racine du site par outils/publier_ovh.py ; sans effet sur GitHub Pages.

Options -Indexes
AddDefaultCharset utf-8
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType text/javascript .js .mjs
AddType application/manifest+json .webmanifest
AddType application/json .json
AddType application/xml .xml
<Files "nouveautes.xml">
  ForceType application/rss+xml
</Files>
AddType font/woff2 .woff2
# WebAssembly (Pyodide de l'atelier Python, demande du domaine Cours, 13 nov. 2026). Le fichier s'appelle
# pyodide.asm.wasm : Apache lit aussi l'extension « .asm » et servait text/x-asm, que le navigateur refuse (nosniff).
# ForceType l'emporte sur tout type déduit des extensions.
AddType application/wasm .wasm
<FilesMatch "\.wasm$">
  ForceType application/wasm
</FilesMatch>
AddType image/svg+xml .svg
AddType image/x-icon .ico

RewriteEngine On
# Liste des empreintes de la publication : interne, jamais servie.
RewriteRule ^\.manifeste-atlas\.json - [F,L]
# HTTPS partout (OVH termine le chiffrement en amont : le port dit si la requête est arrivée en clair).
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# atlasjourdain.fr → www.atlasjourdain.fr, comme sur GitHub Pages.
RewriteCond %{HTTP_HOST} ^atlasjourdain\.fr$ [NC]
RewriteRule ^ https://www.atlasjourdain.fr%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  # Même durée que GitHub Pages (10 min) ; les fichiers ?v= sont de toute façon gardés par le service worker.
  Header set Cache-Control "max-age=600"
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  # En-têtes de sécurité (audit du 22 nov. 2026, MEMO_atlas_apropos.md §91).
  # HTTPS imposé pendant six mois aux navigateurs déjà venus. Pas de « includeSubDomains » : le sous-domaine
  # atelier.atlasjourdain.fr est une application à part, qui règle ses propres en-têtes.
  Header always set Strict-Transport-Security "max-age=15552000"
  # Le site ne s'affiche pas dans un cadre d'un autre site.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Politique de sécurité de contenu : tout vient du site lui-même. Exceptions : la mesure d'audience (envoi du
  # comptage à atlasjourdain.goatcounter.com) et les bibliothèques scientifiques de l'atelier Python, que Pyodide
  # télécharge depuis cdn.jsdelivr.net en vérifiant leur empreinte. « unsafe-inline » : la page est un fichier unique
  # dont scripts et styles sont en ligne. « wasm-unsafe-eval » : Pyodide. Toute nouvelle source extérieure (script,
  # image, police, requête) doit être ajoutée ici, sinon le navigateur la bloque.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://atlasjourdain.goatcounter.com; font-src 'self' data: blob:; connect-src 'self' https://atlasjourdain.goatcounter.com https://cdn.jsdelivr.net; worker-src 'self' blob:; media-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json application/manifest+json application/rss+xml image/svg+xml text/plain application/wasm application/xml
</IfModule>
