# Fichiers produits par la construction : ils sont régénérés à chaque publication.
construction/
site/
node_modules/
__pycache__/
# Vidéos : les rendus sont refaits par fabriquer.sh, ils ne sont pas versionnés.
videos/*/out/
# La vidéo « dérivation » copie le moteur, les polices et les personnages depuis videos/presentation (fabriquer.sh).
videos/derivation/engine/
videos/derivation/fonts/
videos/derivation/chien.js
videos/derivation/jardinier.js
# La vidéo « équations » copie aussi commun.js depuis videos/derivation.
videos/equations/engine/
videos/equations/fonts/
videos/equations/chien.js
videos/equations/jardinier.js
videos/equations/commun.js
# La vidéo « réels et suites » fait les mêmes copies.
videos/reels-suites/engine/
videos/reels-suites/fonts/
videos/reels-suites/chien.js
videos/reels-suites/jardinier.js
videos/reels-suites/commun.js
videos/matrices/engine/
videos/matrices/fonts/
videos/matrices/chien.js
videos/matrices/jardinier.js
videos/matrices/commun.js
videos/espace/engine/
videos/espace/fonts/
videos/espace/chien.js
videos/espace/jardinier.js
videos/espace/commun.js
videos/probabilites/engine/
videos/probabilites/fonts/
videos/probabilites/chien.js
videos/probabilites/jardinier.js
videos/probabilites/commun.js
videos/cartesienne/engine/
videos/cartesienne/fonts/
videos/cartesienne/chien.js
videos/cartesienne/jardinier.js
videos/cartesienne/commun.js
videos/fonctions/engine/
videos/fonctions/fonts/
videos/fonctions/chien.js
videos/fonctions/jardinier.js
videos/fonctions/commun.js
videos/limites-continuite/engine/
videos/limites-continuite/fonts/
videos/limites-continuite/chien.js
videos/limites-continuite/jardinier.js
videos/limites-continuite/commun.js
