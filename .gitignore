# Fichiers produits par la construction : ils sont régénérés à chaque publication.
construction/
site/
node_modules/
__pycache__/
# Vidéos : les rendus sont refaits par fabriquer.sh, ils ne sont pas versionnés.
videos/*/out/
# La vidéo « dérivation » copie le moteur, les polices et les personnages depuis videos/presentation (fabriquer.sh).
videos/derivation/engine/
videos/derivation/fonts/
videos/derivation/chien.js
videos/derivation/jardinier.js
# La vidéo « équations » copie aussi commun.js depuis videos/derivation.
videos/equations/engine/
videos/equations/fonts/
videos/equations/chien.js
videos/equations/jardinier.js
videos/equations/commun.js
